+/// Exact one-shot append-engine phases exposed only to product tests.
+#[cfg(test)]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum TestEngineHookPoint {
+    Admission,
+    PrePwrite,
+    PreFdatasync,
+    PostFdatasyncPrePublication,
+    PostPublicationPreCompletion,
+}
+
+/// A one-shot, real-I/O test hook. Countdown fields count only successfully
+/// completed matching real operations; zero means the next matching operation.
+#[cfg(test)]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum TestEngineHook {
+    Pause {
+        point:         TestEngineHookPoint,
+        after_reaches: usize,
+    },
+    PartialRealWrite {
+        after_successful_pwrites: usize,
+        after_bytes:              usize,
+    },
+    PwriteZero {
+        after_successful_pwrites: usize,
+    },
+    PwriteEio {
+        after_successful_pwrites: usize,
+    },
+    FdatasyncEio {
+        after_successful_fdatasyncs: usize,
+    },
+}
+
+#[cfg(test)]
+#[derive(Default)]
+struct TestEngineHooks {
+    state: std::sync::Mutex<TestEngineHookState>,
+    ready: std::sync::Condvar,
+}
+
+#[cfg(test)]
+#[derive(Default)]
+struct TestEngineHookState {
+    generation:              u64,
+    armed:                   Option<TestEngineHook>,
+    last_reached_generation: u64,
+    claimed_generation:      Option<u64>,
+    paused_generation:       Option<u64>,
+}
+
+#[cfg(test)]
+enum TestPwriteAction {
+    Pass,
+    CountDown(u64),
+    Partial { generation: u64, after_bytes: usize },
+    Zero(u64),
+    Eio(u64),
+}
+
+#[cfg(test)]
+enum TestFdatasyncAction {
+    Pass,
+    CountDown(u64),
+    Eio(u64),
+}
+
+#[cfg(test)]
+impl TestEngineHooks {
+    fn lock(&self) -> std::sync::MutexGuard<'_, TestEngineHookState> {
+        self.state.lock().unwrap_or_else(|poison| poison.into_inner())
+    }
+
+    fn arm(self: &Arc<Self>, hook: TestEngineHook) -> TestEngineHookGuard {
+        if let TestEngineHook::PartialRealWrite { after_bytes, .. } = hook {
+            assert!(after_bytes > 0, "partial write must write a real prefix");
+        }
+        let mut state = self.lock();
+        assert!(state.armed.is_none(), "test engine hook already armed");
+        assert!(
+            state.claimed_generation.is_none(),
+            "test engine hook is still executing"
+        );
+        assert!(
+            state.paused_generation.is_none(),
+            "test engine hook is still paused"
+        );
+        state.generation = state.generation.wrapping_add(1).max(1);
+        let generation = state.generation;
+        state.armed = Some(hook);
+        TestEngineHookGuard { hooks: Arc::clone(self), generation }
+    }
+
+    fn rendezvous(&self, point: TestEngineHookPoint) {
+        let generation = {
+            let mut state = self.lock();
+            let Some(TestEngineHook::Pause {
+                point: armed_point,
+                after_reaches,
+            }) = state.armed.as_mut()
+            else {
+                return;
+            };
+            if *armed_point != point {
+                return;
+            }
+            if *after_reaches > 0 {
+                *after_reaches -= 1;
+                return;
+            }
+            let generation = state.generation;
+            state.armed = None;
+            state.claimed_generation = Some(generation);
+            generation
+        };
+        self.reach_and_pause(generation);
+    }
+
+    fn pwrite_action(&self, buf_len: usize) -> TestPwriteAction {
+        let mut state = self.lock();
+        let generation = state.generation;
+        match state.armed.as_mut() {
+            Some(TestEngineHook::PartialRealWrite {
+                after_successful_pwrites,
+                after_bytes,
+            }) => {
+                if *after_successful_pwrites > 0 {
+                    TestPwriteAction::CountDown(generation)
+                } else {
+                    assert!(
+                        *after_bytes < buf_len,
+                        "partial prefix must be shorter than the real write"
+                    );
+                    let after_bytes = *after_bytes;
+                    state.armed = None;
+                    state.claimed_generation = Some(generation);
+                    TestPwriteAction::Partial { generation, after_bytes }
+                }
+            }
+            Some(TestEngineHook::PwriteZero {
+                after_successful_pwrites,
+            }) => {
+                if *after_successful_pwrites > 0 {
+                    TestPwriteAction::CountDown(generation)
+                } else {
+                    state.armed = None;
+                    state.claimed_generation = Some(generation);
+                    TestPwriteAction::Zero(generation)
+                }
+            }
+            Some(TestEngineHook::PwriteEio {
+                after_successful_pwrites,
+            }) => {
+                if *after_successful_pwrites > 0 {
+                    TestPwriteAction::CountDown(generation)
+                } else {
+                    state.armed = None;
+                    state.claimed_generation = Some(generation);
+                    TestPwriteAction::Eio(generation)
+                }
+            }
+            _ => TestPwriteAction::Pass,
+        }
+    }
+
+    fn fdatasync_action(&self) -> TestFdatasyncAction {
+        let mut state = self.lock();
+        let generation = state.generation;
+        match state.armed.as_mut() {
+            Some(TestEngineHook::FdatasyncEio {
+                after_successful_fdatasyncs,
+            }) => {
+                if *after_successful_fdatasyncs > 0 {
+                    TestFdatasyncAction::CountDown(generation)
+                } else {
+                    state.armed = None;
+                    state.claimed_generation = Some(generation);
+                    TestFdatasyncAction::Eio(generation)
+                }
+            }
+            _ => TestFdatasyncAction::Pass,
+        }
+    }
+
+    fn completed_real_pwrite(&self, generation: u64, succeeded: bool) {
+        if !succeeded {
+            return;
+        }
+        let mut state = self.lock();
+        if state.generation != generation {
+            return;
+        }
+        match state.armed.as_mut() {
+            Some(TestEngineHook::PartialRealWrite {
+                after_successful_pwrites,
+                ..
+            })
+            | Some(TestEngineHook::PwriteZero {
+                after_successful_pwrites,
+            })
+            | Some(TestEngineHook::PwriteEio {
+                after_successful_pwrites,
+            }) => {
+                *after_successful_pwrites =
+                    after_successful_pwrites.saturating_sub(1);
+            }
+            _ => {}
+        }
+    }
+
+    fn completed_real_fdatasync(&self, generation: u64, succeeded: bool) {
+        if !succeeded {
+            return;
+        }
+        let mut state = self.lock();
+        if state.generation != generation {
+            return;
+        }
+        if let Some(TestEngineHook::FdatasyncEio {
+            after_successful_fdatasyncs,
+        }) = state.armed.as_mut()
+        {
+            *after_successful_fdatasyncs =
+                after_successful_fdatasyncs.saturating_sub(1);
+        }
+    }
+
+    fn mark_reached(&self, generation: u64) {
+        let mut state = self.lock();
+        if state.generation == generation
+            && state.claimed_generation == Some(generation)
+        {
+            state.last_reached_generation = generation;
+            state.claimed_generation = None;
+            self.ready.notify_all();
+        }
+    }
+
+    fn reach_and_pause(&self, generation: u64) {
+        let mut state = self.lock();
+        if state.generation != generation
+            || state.claimed_generation != Some(generation)
+        {
+            return;
+        }
+        state.last_reached_generation = generation;
+        state.claimed_generation = None;
+        state.paused_generation = Some(generation);
+        self.ready.notify_all();
+        while state.paused_generation == Some(generation) {
+            state = self
+                .ready
+                .wait(state)
+                .unwrap_or_else(|poison| poison.into_inner());
+        }
+    }
+
+    fn wait_until_reached(&self, generation: u64) {
+        let mut state = self.lock();
+        while state.last_reached_generation < generation
+            && state.generation == generation
+            && (state.armed.is_some()
+                || state.claimed_generation == Some(generation))
+        {
+            state = self
+                .ready
+                .wait(state)
+                .unwrap_or_else(|poison| poison.into_inner());
+        }
+    }
+
+    fn release(&self, generation: u64) {
+        let mut state = self.lock();
+        if state.paused_generation == Some(generation) {
+            state.paused_generation = None;
+            self.ready.notify_all();
+        }
+    }
+
+    fn disarm(&self, generation: u64) {
+        let mut state = self.lock();
+        if state.generation == generation {
+            state.armed = None;
+            state.claimed_generation = None;
+            if state.paused_generation == Some(generation) {
+                state.paused_generation = None;
+            }
+            self.ready.notify_all();
+        }
+    }
+
+    fn disarm_all(&self) {
+        let mut state = self.lock();
+        state.armed = None;
+        state.claimed_generation = None;
+        state.paused_generation = None;
+        self.ready.notify_all();
+    }
+}
+
+/// Generation-bound safety guard for one armed test engine hook.
+#[cfg(test)]
+pub struct TestEngineHookGuard {
+    hooks:      Arc<TestEngineHooks>,
+    generation: u64,
+}
+
+#[cfg(test)]
+impl TestEngineHookGuard {
+    pub fn wait_until_reached(&self) {
+        self.hooks.wait_until_reached(self.generation);
+    }
+
+    pub fn release(&self) { self.hooks.release(self.generation); }
+}
+
+#[cfg(test)]
+impl Drop for TestEngineHookGuard {
+    fn drop(&mut self) { self.hooks.disarm(self.generation); }
+}
+
+#[cfg(test)]
+#[derive(Clone)]
+struct TestEngineFs {
+    inner: EngineFs,
+    hooks: Arc<TestEngineHooks>,
+}
+
+#[cfg(test)]
+impl LogFs for TestEngineFs {
+    type File = TestEngineFile;
+
+    fn open(&self, path: &Path, opts: OpenOpts) -> std::io::Result<Self::File> {
+        self.inner.open(path, opts).map(|inner| TestEngineFile {
+            inner,
+            hooks: Arc::clone(&self.hooks),
+        })
+    }
+
+    fn rename(&self, from: &Path, to: &Path) -> std::io::Result<()> {
+        self.inner.rename(from, to)
+    }
+
+    fn remove(&self, path: &Path) -> std::io::Result<()> {
+        self.inner.remove(path)
+    }
+}
+
+#[cfg(test)]
+#[derive(Clone)]
+struct TestEngineFile {
+    inner: EngineFile,
+    hooks: Arc<TestEngineHooks>,
+}
+
+#[cfg(test)]
+impl FileHandle for TestEngineFile {
+    fn pwrite(&self, off: u64, buf: &[u8]) -> std::io::Result<usize> {
+        self.hooks.rendezvous(TestEngineHookPoint::PrePwrite);
+        match self.hooks.pwrite_action(buf.len()) {
+            TestPwriteAction::Pass => self.inner.pwrite(off, buf),
+            TestPwriteAction::CountDown(generation) => {
+                let result = self.inner.pwrite(off, buf);
+                self.hooks
+                    .completed_real_pwrite(generation, result.is_ok());
+                result
+            }
+            TestPwriteAction::Partial { generation, after_bytes } => {
+                let prefix = self.inner.pwrite(off, &buf[..after_bytes]);
+                let written = match prefix {
+                    Ok(written) if written == after_bytes => written,
+                    other => {
+                        self.hooks.mark_reached(generation);
+                        return other;
+                    }
+                };
+                self.hooks.reach_and_pause(generation);
+                self.inner
+                    .pwrite(off + written as u64, &buf[written..])
+                    .map(|rest| written + rest)
+            }
+            TestPwriteAction::Zero(generation) => {
+                self.hooks.mark_reached(generation);
+                Ok(0)
+            }
+            TestPwriteAction::Eio(generation) => {
+                self.hooks.mark_reached(generation);
+                Err(std::io::Error::from_raw_os_error(5))
+            }
+        }
+    }
+
+    fn pread(&self, off: u64, buf: &mut [u8]) -> std::io::Result<usize> {
+        self.inner.pread(off, buf)
+    }
+
+    fn fdatasync(&self) -> std::io::Result<()> {
+        self.hooks.rendezvous(TestEngineHookPoint::PreFdatasync);
+        let result = match self.hooks.fdatasync_action() {
+            TestFdatasyncAction::Pass => self.inner.fdatasync(),
+            TestFdatasyncAction::CountDown(generation) => {
+                let result = self.inner.fdatasync();
+                self.hooks
+                    .completed_real_fdatasync(generation, result.is_ok());
+                result
+            }
+            TestFdatasyncAction::Eio(generation) => {
+                self.hooks.mark_reached(generation);
+                Err(std::io::Error::from_raw_os_error(5))
+            }
+        };
+        if result.is_ok() {
+            self.hooks.rendezvous(
+                TestEngineHookPoint::PostFdatasyncPrePublication,
+            );
+        }
+        result
+    }
+
+    fn len(&self) -> std::io::Result<u64> { self.inner.len() }
+
+    fn allocate(&self, len: u64) -> std::io::Result<()> {
+        self.inner.allocate(len)
+    }
+}
