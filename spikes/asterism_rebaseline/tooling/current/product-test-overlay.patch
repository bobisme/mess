+#[cfg(test)]
+fn test_segment_writer(
+    rt: &RealRuntime,
+    plan: ResumePlan,
+    seg_path: &Path,
+    segment_size: u64,
+    test_hooks: &Arc<TestEngineHooks>,
+) -> Result<SegmentWriter<TestEngineFs>, EngineError> {
+    let fs = TestEngineFs {
+        inner: rt.fs(),
+        hooks: Arc::clone(test_hooks),
+    };
+    match plan {
+        ResumePlan::Fresh => {
+            let params = SegmentParams {
+                segment_id:         ACTIVE_SEGMENT_ID,
+                base_pos:           0,
+                epoch:              1,
+                prev_segment_epoch: 0,
+                created_unix_nanos: 0,
+                segment_size,
+            };
+            SegmentWriter::create(&fs, seg_path, params)
+                .map_err(|e| EngineError::Open(format!("segment create: {e}")))
+        }
+        ResumePlan::Resume(info) => {
+            let params = ResumeParams {
+                segment_id: info.segment_id,
+                base_pos: info.base_pos,
+                epoch: info.epoch,
+                segment_size,
+                write_off: info.write_off,
+                next_batch_id: info.next_batch_id,
+                next_pos: info.next_pos,
+                batch_count: info.batch_count,
+                event_count: info.event_count,
+            };
+            SegmentWriter::resume(&fs, seg_path, params)
+                .map_err(|e| EngineError::Open(format!("segment resume: {e}")))
+        }
+    }
+}
