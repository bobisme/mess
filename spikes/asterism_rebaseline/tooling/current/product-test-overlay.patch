+#[cfg(test)]
+#[derive(Clone)]
+struct TestEngineFile {
+    inner: EngineFile,
+    hooks: Arc<TestEngineHooks>,
+}
+
+#[cfg(test)]
+impl FileHandle for TestEngineFile {
+    fn pwrite(&self, off: u64, buf: &[u8]) -> std::io::Result<usize> {
+        self.hooks.rendezvous(TestEngineHookPoint::PrePwrite);
+        match self.hooks.pwrite_action(buf.len()) {
+            TestPwriteAction::Pass => self.inner.pwrite(off, buf),
+            TestPwriteAction::CountDown(generation) => {
+                let result = self.inner.pwrite(off, buf);
+                self.hooks
+                    .completed_real_pwrite(generation, result.is_ok());
+                result
+            }
+            TestPwriteAction::Partial { generation, after_bytes } => {
+                let prefix = self.inner.pwrite(off, &buf[..after_bytes]);
+                let written = match prefix {
+                    Ok(written) if written == after_bytes => written,
+                    other => {
+                        self.hooks.mark_reached(generation);
+                        return other;
+                    }
+                };
+                self.hooks.reach_and_pause(generation);
+                self.inner
+                    .pwrite(off + written as u64, &buf[written..])
+                    .map(|rest| written + rest)
+            }
+            TestPwriteAction::Zero(generation) => {
+                self.hooks.mark_reached(generation);
+                Ok(0)
+            }
+            TestPwriteAction::Eio(generation) => {
+                self.hooks.mark_reached(generation);
+                Err(std::io::Error::from_raw_os_error(5))
+            }
+        }
+    }
+
+    fn pread(&self, off: u64, buf: &mut [u8]) -> std::io::Result<usize> {
+        self.inner.pread(off, buf)
+    }
+
+    fn fdatasync(&self) -> std::io::Result<()> {
+        self.hooks.rendezvous(TestEngineHookPoint::PreFdatasync);
+        let result = match self.hooks.fdatasync_action() {
+            TestFdatasyncAction::Pass => self.inner.fdatasync(),
+            TestFdatasyncAction::CountDown(generation) => {
+                let result = self.inner.fdatasync();
+                self.hooks
+                    .completed_real_fdatasync(generation, result.is_ok());
+                result
+            }
+            TestFdatasyncAction::Eio(generation) => {
+                self.hooks.mark_reached(generation);
+                Err(std::io::Error::from_raw_os_error(5))
+            }
+        };
+        if result.is_ok() {
+            self.hooks.rendezvous(
+                TestEngineHookPoint::PostFdatasyncPrePublication,
+            );
+        }
+        result
+    }
+
+    fn len(&self) -> std::io::Result<u64> { self.inner.len() }
+
+    fn allocate(&self, len: u64) -> std::io::Result<()> {
+        self.inner.allocate(len)
+    }
+}
