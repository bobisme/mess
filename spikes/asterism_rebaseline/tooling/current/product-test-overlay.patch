+#[cfg(test)]
+impl LogEngine {
+    /// Arm one generation-bound engine hook. This API exists only in unit-test
+    /// builds, so no release or benchmark binary can enable the overlay.
+    pub fn arm_test_hook(&self, hook: TestEngineHook) -> TestEngineHookGuard {
+        self.inner.test_hooks.arm(hook)
+    }
+
+    /// Cohort a known number of already-open-engine append intents.
+    pub fn arm_test_owner_cohort(
+        &self,
+        expected: usize,
+    ) -> TestOwnerCohortGuard {
+        self.inner.owner.cohort_gate.arm(expected)
+    }
+}
