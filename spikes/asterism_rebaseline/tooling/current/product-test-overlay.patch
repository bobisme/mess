+#[cfg(test)]
+impl LogFs for TestEngineFs {
+    type File = TestEngineFile;
+
+    fn open(&self, path: &Path, opts: OpenOpts) -> std::io::Result<Self::File> {
+        self.inner.open(path, opts).map(|inner| TestEngineFile {
+            inner,
